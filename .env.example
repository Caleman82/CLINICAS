# Copiá este archivo a .env.local y completá los valores. NUNCA subas .env.local al repositorio.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca con prefijo NEXT_PUBLIC_ ni en código del navegador.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app, sin barra final (se usa para armar los enlaces de invitación).
APP_URL=http://localhost:3000

# Email transaccional (Resend). Opcional: sin estas variables, las invitaciones se
# muestran para copiar y enviar por WhatsApp. EMAIL_FROM debe ser de un dominio verificado.
RESEND_API_KEY=
EMAIL_FROM="Nombre de la app <avisos@tudominio.com>"

# Tests de base de datos: Postgres local donde se crea la base clinicas_test.
TEST_DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Script crear-superadmin
SUPERADMIN_EMAIL=
